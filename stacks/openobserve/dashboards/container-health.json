{
  "version": 2,
  "title": "Container Health",
  "description": "Per-container resource usage from docker_stats receiver. Shows CPU, memory, network, and restart counts for all Glasswing services.",
  "panels": [
    {
      "id": "container_cpu",
      "type": "line",
      "title": "Container CPU Usage",
      "description": "CPU usage per container over time",
      "config": {
        "show_legends": true,
        "unit": "percent-1"
      },
      "queryType": "promql",
      "queries": [
        {
          "query": "sum by(container_name) (irate(container_cpu_usage_percent[5m]))",
          "customQuery": true,
          "fields": {
            "stream": "container_cpu_usage_percent",
            "stream_type": "metrics",
            "x": [],
            "y": []
          },
          "config": {
            "promql_legend": "{container_name}",
            "layer_type": "scatter"
          }
        }
      ],
      "layout": { "x": 0, "y": 0, "w": 12, "h": 5 }
    },
    {
      "id": "container_memory_used",
      "type": "line",
      "title": "Container Memory Usage",
      "description": "Memory used per container",
      "config": {
        "show_legends": true,
        "unit": "bytes"
      },
      "queryType": "promql",
      "queries": [
        {
          "query": "container_memory_usage_bytes{}",
          "customQuery": true,
          "fields": {
            "stream": "container_memory_usage_bytes",
            "stream_type": "metrics",
            "x": [],
            "y": []
          },
          "config": {
            "promql_legend": "{container_name}",
            "layer_type": "scatter"
          }
        }
      ],
      "layout": { "x": 0, "y": 5, "w": 12, "h": 5 }
    },
    {
      "id": "container_memory_limit",
      "type": "line",
      "title": "Container Memory Limit",
      "description": "Memory limit per container",
      "config": {
        "show_legends": true,
        "unit": "bytes"
      },
      "queryType": "promql",
      "queries": [
        {
          "query": "container_memory_limit{}",
          "customQuery": true,
          "fields": {
            "stream": "container_memory_limit",
            "stream_type": "metrics",
            "x": [],
            "y": []
          },
          "config": {
            "promql_legend": "{container_name}",
            "layer_type": "scatter"
          }
        }
      ],
      "layout": { "x": 0, "y": 10, "w": 12, "h": 5 }
    },
    {
      "id": "container_network_rx",
      "type": "line",
      "title": "Container Network: Received",
