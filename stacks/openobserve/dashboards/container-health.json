      "config": {
        "show_legends": true,
        "unit": "bps"
      },
      "queryType": "promql",
      "queries": [
        {
          "query": "irate(container_network_io{direction=\"receive\"}[5m])",
          "customQuery": true,
          "fields": {
            "stream": "container_network_io",
            "stream_type": "metrics",
            "x": [],
            "y": []
          },
          "config": {
            "promql_legend": "{container_name}",
            "layer_type": "scatter"
          }
        }
      ],
      "layout": { "x": 0, "y": 15, "w": 6, "h": 5 }
    },
    {
      "id": "container_network_tx",
      "type": "line",
