# Bootstrap configuration for the Infisical stack.
#
# Infisical cannot fetch its own secrets, so this file is the root of the
# platform's trust chain. It is git-ignored; this example is not.
#
#   cp stacks/infisical/.env.example stacks/infisical/.env
#   chmod 600 stacks/infisical/.env
#
# Generate the three secrets once, while the values are still blank. Changing
# POSTGRES_PASSWORD after the database exists locks you out; changing
# ENCRYPTION_KEY after secrets exist makes every stored value unreadable.

# LAN address every published port binds to. The Makefile exports this to every
# stack, and ACCESS.md is generated from it.
GLASSWING_HOST_IP=192.168.68.62

# Public URL served by the nginx gateway (compose publishes 8095 -> 443).
SITE_URL=https://192.168.68.62:8095

# Password for the bundled PostgreSQL. This one is embedded in a connection
# URL (postgresql://...), so generate a URL-safe value: base64 can contain
# '/', '+', and '=', which break the URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# 16-byte hex key (32 hex characters) that encrypts secrets at rest.
#   openssl rand -hex 16
ENCRYPTION_KEY=

# Signs Infisical session tokens; any long random string.
#   openssl rand -base64 32
AUTH_SECRET=
