# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build Next.js frontend
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS web-build

WORKDIR /app

COPY src/web/package.json src/web/package-lock.json* ./
RUN npm ci --ignore-scripts || npm ci

COPY src/web/ .
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Run Next.js in production mode
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS web-run

WORKDIR /app

# Copy production dependencies and build output
COPY --from=web-build /app/package.json ./
COPY --from=web-build /app/node_modules ./node_modules
COPY --from=web-build /app/.next ./.next
COPY --from=web-build /app/next.config.js ./
COPY --from=web-build /app/public ./public

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000 || exit 1

CMD ["npm", "start"]
