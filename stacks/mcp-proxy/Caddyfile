# Glasswing MCP Proxy — Caddy reverse proxy for all MCP servers
# Logs every request as structured JSON to stdout (Vector -> OpenObserve)

{
    auto_https off
    log {
        output stdout
        format json
    }
}

# Serena MCP
http://:9001 {
    reverse_proxy serena:9121 {
        header_up X-Real-IP {remote_host}
    }
}

# Steel MCP
http://:9002 {
    reverse_proxy steel-mcp:8000 {
        header_up X-Real-IP {remote_host}
    }
}

# Open Notebook MCP
http://:9003 {
    reverse_proxy open-notebook-mcp:8000 {
        header_up X-Real-IP {remote_host}
    }
}

# SearXNG MCP
http://:9004 {
    reverse_proxy searxng-mcp:8000 {
        header_up X-Real-IP {remote_host}
    }
}

# REA MCP
http://:9005 {
    reverse_proxy rea-mcp:8000 {
        header_up X-Real-IP {remote_host}
    }
}

# Sequential Thinking MCP
http://:9006 {
    reverse_proxy sequential-thinking-mcp:8000 {
        header_up X-Real-IP {remote_host}
    }
}
