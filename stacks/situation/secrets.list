# Global: loaded automatically from /global
# Stack path: /situation

# Telegram (required)
TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID

# LiteLLM (reused from /litellm for spend data)
LITELLM_MASTER_KEY

# OpenObserve (reused from /openobserve for error logs)
ZO_ROOT_USER_EMAIL
ZO_ROOT_USER_PASSWORD

# Uptime Kuma API token (for /api/status)
KUMA_API_TOKEN

# Beszel API key (for /api/v1/agents)
BESZEL_API_KEY

# Paperless API token (for #file inbox — created in Paperless UI)
PAPERLESS_API_TOKEN
