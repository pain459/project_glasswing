# ─────────────────────────────────────────────────────────────────────────────
# ATLAS Web — React + CesiumJS frontend served by nginx
# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build the frontend
FROM node:22-slim AS build

WORKDIR /build

# Install pnpm
RUN corepack enable && corepack prepare pnpm@11.24.0 --activate

# Copy workspace config and package files first (better layer caching)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy frontend source
COPY apps/web/ ./apps/web/

# Build production frontend
RUN pnpm --filter @atlas/web build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve with nginx
FROM nginx:1.27-alpine

# Nginx configuration embedded directly (build context is ATLAS source, not Glasswing)
RUN mkdir -p /etc/nginx/conf.d && \
    cat > /etc/nginx/conf.d/default.conf << 'NGINX'
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf|eot|ktx2|wasm|glb)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff;
    }

    location /Cesium/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /manifest.webmanifest {
        add_header Content-Type "application/manifest+json";
        expires 1d;
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location /api/ {
        proxy_pass http://glasswing-atlas-engine:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
NGINX

# Copy built frontend from build stage
COPY --from=build /build/apps/web/dist/ /usr/share/nginx/html/

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD wget -qO- http://127.0.0.1:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
