{
  "$schema": "https://opencode.ai/config.json",

  // The coding model is served by the local Ollama instance.
  "model": "ollama/qwen3.6-opencode:latest",
  "shell": "/bin/bash",
  "update": "disable",

  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "http://192.168.68.62:11434/v1"
      },
      "models": {
        "qwen3.6-opencode:latest": {
          "name": "Qwen 3.6 OpenCode (Ollama, 128k)",
          // Ollama's model is built with num_ctx 131072, even though its
          // metadata advertises a larger architectural maximum.
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },

  // Open Notebook is the retrieval layer for documents that do not fit in
  // the model window. The sidecar exposes its MCP server on the stack network.
  "mcp": {
    "servers": {
      "open-notebook": {
        "type": "remote",
        "url": "http://open-notebook-mcp:8000/mcp",
        "oauth": false
      },
      // Steel is the browsing layer: it drives a real Chrome in the
      // self-hosted Steel service for pages that plain fetches cannot read.
      "steel": {
        "type": "remote",
        "url": "http://steel-mcp:8000/mcp",
        "oauth": false
      }
    }
  },

  // Keep enough recent detail for coding work while leaving room for retrieval.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 20000
  },

  "instructions": ["/etc/opencode/AGENTS.md"]
}
