{
  "$schema": "https://opencode.ai/config.json",

  // The coding model is served by the local Ollama instance.
  "model": "ollama/qwen3.6-opencode:latest",
  "shell": "/bin/bash",
  "update": "disable",

  "providers": {
    "ollama": {
      "settings": {
        // The Ollama and OpenCode stacks use separate Compose networks. If
        // they are ever joined to a shared network, use
        // http://glasswing-ollama:11434/v1 instead of the host address.
        "baseURL": "http://192.168.68.62:11434/v1"
      },
      "models": {
        "qwen3.6-opencode:latest": {
          "name": "Qwen 3.6 OpenCode (Ollama, 128k)",
          // Ollama's model is built with num_ctx 131072, even though its
          // metadata advertises a larger architectural maximum. These limits
          // must stay equal to num_ctx and num_predict in
          // stacks/ollama/models/qwen3.6-opencode.Modelfile. Declaring a
          // window here does not allocate it in Ollama.
          "limit": {
            "context": 131072,
            "output": 32768
          },
          // Thinking is off for coding. With it on, the trace consumed the
          // entire generation budget in testing and the request ended with
          // done_reason=length and no visible answer. Ollama exposes a
          // boolean thinking toggle for this model, so "none" means think=false.
          "body": {
            "reasoning_effort": "none",
            "temperature": 0.3
          }
        }
      }
    }
  },

  // Open Notebook is the retrieval layer for documents that do not fit in
  // the model window. The sidecar exposes its MCP server on the stack network.
  "mcp": {
    "servers": {
      "open-notebook": {
        "type": "remote",
        "url": "http://open-notebook-mcp:8000/mcp",
        "oauth": false
      },
      // Steel is the browsing layer: it drives a real Chrome in the
      // self-hosted Steel service for pages that plain fetches cannot read.
      "steel": {
        "type": "remote",
        "url": "http://steel-mcp:8000/mcp",
        "oauth": false
      }
    }
  },

  // Keep enough recent detail for coding work while leaving room for retrieval.
  // `buffer` is the reserved context below the 131k limit (the V1 `reserved`
  // setting); V2 uses keep.tokens plus buffer instead of V1 pruning.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 20000
  },

  "instructions": ["/etc/opencode/AGENTS.md"]
}
