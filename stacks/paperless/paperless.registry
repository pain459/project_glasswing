# Paperless-ngx configuration registry
#
# Values marked <generate> must be created by the operator before registering.
#
PAPERLESS_SECRET_KEY=
#   Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=
#   Generate with: openssl rand -hex 24
PAPERLESS_DB_NAME=paperless
#
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=
#   Choose a strong password for the Paperless web UI.
