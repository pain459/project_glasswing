# Global shared configuration — Infisical path /global
# These variables are common across all Glasswing stacks.

# Timezone for all services
GLASSWING_TZ=Asia/Kolkata

# Host IP address
GLASSWING_HOST_IP=192.168.68.62

# Default user/group IDs
GLASSWING_PUID=1000
GLASSWING_PGID=1000

# OpenTelemetry configuration (identical across all stacks)
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.68.62:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=homelab,host.name=pathfinder
